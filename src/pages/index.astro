---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, getTotalPages } from '../data/projects';

const totalPages = getTotalPages();
const perPage = 7;

function getCardClass(cardIndex: number): string {
	const pos = cardIndex % perPage;
	if (pos === 0 || pos === 1 || pos === 6) return 'card-wide';
	return 'card-narrow';
}

interface TimelineItem {
	logo: string;
	appointment: string;
	alt: string;
	company: string;
	period: string;
	details: string[];
}

const workItems: TimelineItem[] = [
	{
		logo: '/images/2025/minos.png',
		appointment: 'Python Software Developer',
		alt: 'Minos Global',
		company: 'Minos Global',
		period: 'Dic 2024 - Present',
		details: ['FastAPI', 'PostgreSQL', 'Pydantic', 'Docker', 'Postman', 'Sumsub'],
	},
	{
		logo: '/images/2024/11/3xs.png',
		alt: 'Systems, Servers & Solutions',
		appointment: 'Java Software Developer',
		company: 'Systems, Servers & Solutions',
		period: 'Jun 2023 - Dic 2024',
		details: ['Spring Boot', 'Redis', 'Postman', 'Proxmox', 'Jenkins'],
	},
	{
		logo: '/images/2024/11/fundamentia_icon.svg',
		alt: 'Fundamentia',
		appointment: 'Java Software Developer',
		company: 'Fundamentia',
		period: 'Feb 2022 - Jun 2023',
		details: ['Regex', 'Tomcat', 'Maven', 'MySQL'],
	},
	{
		logo: '/images/2024/11/images.png',
		appointment: 'Unreal VR Game Developer',
		alt: 'NeoColiseumVR',
		company: 'NeoColiseumVR',
		period: 'Dec 2019 - Feb 2022',
		details: ['Unreal Engine 5', 'C++'],
	},
];

const studyItems: TimelineItem[] = [
	{
		logo: '/images/2024/11/uoc.png',
		alt: 'Universitat Oberta de Catalunya',
		appointment: "Master's in Mobile Application Development",
		company: 'Universidad de Alicante (UA)',
		period: 'Sept 2023 - Jun 2025',
		details: ['Android', 'Kotlin', 'iOS', 'Flutter'],
	},
	{
		logo: '/images/2024/11/ua.png',
		alt: 'Universidad de Alicante',
		appointment: "Bachelor's in Multimedia Engineering",
		company: 'Universidad de Alicante (UA)',
		period: 'Sept 2015 - Jun 2019',
		details: ['C++', 'OpenGL', 'Unity', 'Unreal Engine', 'VR/AR'],
	},
];

// Interleave: work[0], study[0], work[1], work[2], work[3], study[1]
const maxRows = Math.max(workItems.length, studyItems.length);
const timelineRows: { work?: TimelineItem; study?: TimelineItem }[] = [];
for (let i = 0; i < maxRows; i++) {
	const row: { work?: TimelineItem; study?: TimelineItem } = {};
	if (workItems[i]) row.work = workItems[i];
	if (studyItems[i]) row.study = studyItems[i];
	timelineRows.push(row);
}
---

<Layout title="Ángel J. Terol | Portfolio" description="Portfolio of Ángel J. Terol, game and software developer.">
	<Header slot="header" />

	<div class="container">
		<!-- Portfolio Section -->
		<section id="portfolio" class="portfolio-section">
			<div class="project-grid" aria-label="Project list" data-total-pages={totalPages}>
				{projects.map((project, index) => {
					const pageIndex = Math.floor(index / perPage);
					const cardClass = getCardClass(index);
					return (
						<ProjectCard
							project={project}
							class={`project-page-${pageIndex} ${cardClass}`}
							style={pageIndex === 0 ? '' : 'display: none;'}
						/>
					);
				})}
			</div>

			{totalPages > 1 && (
				<div class="pagination">
					<div class="pagination-dots" id="pagination-dots">
						{Array.from({ length: totalPages }, (_, i) => (
							<button class={`pagination-dot ${i === 0 ? 'active' : ''}`} data-page={i} aria-label={`Page ${i + 1}`}></button>
						))}
					</div>
				</div>
			)}
		</section>
		<!-- About Section -->
		<section id="about" class="about-section">
			<header class="page-header">
				<h1>Ángel Jesús Terol Martínez</h1>
			</header>
			<div class="about-layout">
				<aside class="about-profile">
					<img src="/images/2024/11/icon_512.png" alt="Ángel Jesús Terol" width="512" height="512" />
				</aside>

				<div class="about-content">
					<p class="about-bio">
						Multimedia Engineering graduate with professional experience in software development, backend systems, enterprise applications, and mobile development. Recently completed a Master's degree in Mobile Application Development, with expertise in native Android development using Kotlin. Proficient in Python, Java, C++, and Assembly, with experience building custom software, graphics engines, emulators, and scalable backend services. Familiar with frameworks such as FastAPI, Spring Boot and experienced in immersive technologies like Virtual Reality (VR). Passionate about designing efficient, maintainable, and innovative software solutions.
					</p>
					<SocialLinks />
				</div>
			</div>
			<h2>Experience</h2>
			<div class="timeline">
				{timelineRows.map((row) => (
					<div class="timeline-row">
						{row.work && (
							<div class="timeline-item left">
								<div class="timeline-card">
									<img src={row.work.logo} alt={row.work.alt} width="80" height="80" />
									<div class="timeline-card-body">
										<p class="period">{row.work.period}</p>
										<h3>{row.work.appointment}</h3>
										<h4>{row.work.company}</h4>
										<div class="timeline-tags">
											{row.work.details.map((detail) => (
												<span class="timeline-tag">{detail}</span>
											))}
										</div>
									</div>
								</div>
								<div class="timeline-dot" />
							</div>
						)}
						{row.study && (
							<div class="timeline-item right">
								<div class="timeline-card">
									<img src={row.study.logo} alt={row.study.alt} width="80" height="80" />
									<div class="timeline-card-body">
										<p class="period">{row.study.period}</p>
										<h3>{row.study.appointment}</h3>
										<h4>{row.study.company}</h4>
										<div class="timeline-tags">
											{row.study.details.map((detail) => (
												<span class="timeline-tag">{detail}</span>
											))}
										</div>
									</div>
								</div>
								<div class="timeline-dot" />
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</div>

	<Footer slot="footer" />
</Layout>

<script>
	(function() {
		const gridEl = document.querySelector('.project-grid') as HTMLElement | null;
        if (!gridEl) 
			return;
        const grid = gridEl;

		const totalPages = parseInt(grid.dataset.totalPages || '1', 10);
		if (totalPages <= 1) 
			return;

		const dotsContainer = document.getElementById('pagination-dots');

		let isTransitioning = false;

		function showPage(page: number) {
			if (isTransitioning) 
				return;
    		isTransitioning = true;

			const cards = Array.from(grid.querySelectorAll('.project-card')) as HTMLElement[];
    		const visibleCards = cards.filter((c) => c.style.display !== 'none');

			visibleCards.forEach((el) => el.classList.add('fade-out'));

			setTimeout(() => {
				cards.forEach((el) => {
					if (el.classList.contains('project-page-' + page)) {
						el.style.display = '';
					} else {
						el.style.display = 'none';
					}
				});

				const dots = dotsContainer?.querySelectorAll('.pagination-dot');
				dots?.forEach((dot, idx) => {
					dot.classList.toggle('active', idx === page);
				});

				window.scrollTo({ top: 0, behavior: 'smooth' });

				const newVisibleCards = cards.filter((c) => c.style.display !== 'none');
				newVisibleCards.forEach((el) => el.classList.add('fade-out'));

				void grid.offsetHeight;
				newVisibleCards.forEach((el) => el.classList.remove('fade-out'));

				isTransitioning = false;
			}, 300);
		}

		dotsContainer?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.classList.contains('pagination-dot')) {
				const page = parseInt(target.dataset.page || '0', 10);
				showPage(page);
			}
		});
	})();
</script>
