---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, getTotalPages } from '../data/projects';

const totalPages = getTotalPages();
const perPage = 7;

function getCardClass(cardIndex: number): string {
	const pos = cardIndex % perPage;
	if (pos === 0 || pos === 1 || pos === 6) return 'card-wide';
	return 'card-narrow';
}
---

<Layout title="Ángel J. Terol | Portfolio" description="Portfolio of Ángel J. Terol, game and software developer.">
	<Header slot="header" />

	<div class="container">
		<!-- Portfolio Section -->
		<section id="portfolio" class="portfolio-section">
			<div class="project-grid" aria-label="Project list" data-total-pages={totalPages}>
				{projects.map((project, index) => {
					const pageIndex = Math.floor(index / perPage);
					const cardClass = getCardClass(index);
					return (
						<ProjectCard
							project={project}
							class={`project-page-${pageIndex} ${cardClass}`}
							style={pageIndex === 0 ? '' : 'display: none;'}
						/>
					);
				})}
			</div>

			{totalPages > 1 && (
				<div class="pagination">
					<div class="pagination-dots" id="pagination-dots">
						{Array.from({ length: totalPages }, (_, i) => (
							<button class={`pagination-dot ${i === 0 ? 'active' : ''}`} data-page={i} aria-label={`Page ${i + 1}`}></button>
						))}
					</div>
				</div>
			)}
		</section>
		<!-- About Section -->
		<section id="about" class="about-section">
			<header class="page-header">
				<h1>About</h1>
			</header>
			<div class="about-layout">
				<aside class="about-profile">
					<img src="/images/2024/11/icon_512.png" alt="Ángel Jesús Terol" width="512" height="512" />
					<h2>Ángel Jesús Terol Martínez</h2>
					<SocialLinks />
				</aside>

				<div class="about-content">
					<p class="about-bio">
						Multimedia Engineering graduate with experience in software development, game creation, and enterprise applications. Skilled in programming with Assembly, C++, and Java, with a strong foundation in building custom solutions, including graphics engines and backend systems. Experienced in immersive technologies like VR and in developing scalable applications using frameworks such as Spring Boot. Adept at adapting to diverse challenges and delivering innovative, efficient solutions.
					</p>

					<h2>Work Experience</h2>
					<div class="experience-list">
						<article class="experience-item">
							<img src="/images/2024/11/logosystems.png" alt="Systems, Servers & Solutions SL" width="682" height="382" />
							<div>
								<h3>Systems, Servers & Solutions SL.</h3>
								<p class="period">Mutxamel, 2023 – 2024</p>
								<ul>
									<li>Java 17 Developer</li>
									<li>Spring Boot</li>
								</ul>
							</div>
						</article>

						<article class="experience-item">
							<img src="/images/2024/11/fundamentia-logo.png" alt="Fundamentia" width="504" height="60" />
							<div>
								<h3>Fundamentia</h3>
								<p class="period">Elche/Elx, 2022 – 2023</p>
								<ul>
									<li>Java 8 Developer</li>
									<li>Automated analysis of banking documents.</li>
								</ul>
							</div>
						</article>

						<article class="experience-item">
							<img src="/images/2024/11/images.png" alt="NeoColiseumVR" width="420" height="120" />
							<div>
								<h3>NeoColiseumVR</h3>
								<p class="period">Sant Joan, 2019 – 2022</p>
								<ul>
									<li>VR Game Programmer</li>
									<li>Unreal Engine 4 / 5</li>
									<li>C++ / Blueprints</li>
								</ul>
							</div>
						</article>
					</div>
				</div>
			</div>
		</section>
	</div>

	<Footer slot="footer" />
</Layout>

<script>
	(function() {
		const gridEl = document.querySelector('.project-grid') as HTMLElement | null;
        if (!gridEl) 
			return;
        const grid = gridEl;

		const totalPages = parseInt(grid.dataset.totalPages || '1', 10);
		if (totalPages <= 1) 
			return;

		const dotsContainer = document.getElementById('pagination-dots');

		let isTransitioning = false;

		function showPage(page: number) {
			if (isTransitioning) 
				return;
    		isTransitioning = true;

			const cards = Array.from(grid.querySelectorAll('.project-card')) as HTMLElement[];
    		const visibleCards = cards.filter((c) => c.style.display !== 'none');

			visibleCards.forEach((el) => el.classList.add('fade-out'));

			setTimeout(() => {
				cards.forEach((el) => {
					if (el.classList.contains('project-page-' + page)) {
						el.style.display = '';
					} else {
						el.style.display = 'none';
					}
				});

				const dots = dotsContainer?.querySelectorAll('.pagination-dot');
				dots?.forEach((dot, idx) => {
					dot.classList.toggle('active', idx === page);
				});

				window.scrollTo({ top: 0, behavior: 'smooth' });

				const newVisibleCards = cards.filter((c) => c.style.display !== 'none');
				newVisibleCards.forEach((el) => el.classList.add('fade-out'));
				
				void grid.offsetHeight;
				newVisibleCards.forEach((el) => el.classList.remove('fade-out'));

				isTransitioning = false;
			}, 300);
		}

		dotsContainer?.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.classList.contains('pagination-dot')) {
				const page = parseInt(target.dataset.page || '0', 10);
				showPage(page);
			}
		});
	})();
</script>
