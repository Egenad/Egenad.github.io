---
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import { projects, getProject } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// "C++, CPCTelera" -> ["C++", "CPCTelera"]
const techList = project.technologies
  ? project.technologies.split(',').map((t) => t.trim()).filter(Boolean)
  : [];
---

<Layout title={`${project.title} | Ángel J. Terol`} description={project.excerpt}>
  <Header slot="header" />

  <div class="container">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Portfolio
    </a>

    <article class="project-detail">
      <header class="project-hero-wrap">
        <img src={project.featuredImage} alt={project.title} class="project-hero" />
        
      </header>

      <div class="project-header">
        <h1>{project.title}</h1>

        <div class="project-meta">
          {project.year && <span class="chip chip-year">{project.year}</span>}
          {techList.map((tech) => <span class="chip">{tech}</span>)}
        </div>

        {(project.github) && (
          <div class="project-actions">
            {project.github && (
              <a href={project.github} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55v-2.17c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
                GitHub
              </a>
            )}
          </div>
        )}
      </div>

      <div class="project-content" set:html={project.content} />
    </article>
  </div>

  <Footer slot="footer" />
  <Lightbox />
</Layout>

<style>
  .container {
    max-width: 860px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted, #6b6b76);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .back-link:hover {
    color: var(--color-accent, #d97757);
    transform: translateX(-2px);
  }

  .project-hero-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 2rem;
    
  }

  .project-hero {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    display: block;
  }

  .project-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 0.9rem;
    letter-spacing: -0.01em;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted, #1010c0);;
  }

  .chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-chip-bg, #f0efe9);
    border: 1px solid var(--color-chip-border, rgba(0, 0, 0, 0.06));
  }

  .chip-year {
    background: var(--color-accent-soft, rgba(217, 119, 87, 0.12));
    color: var(--color-accent, #d97757);
    border-color: transparent;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-primary {
    background: var(--color-text, #1a1a1a);
    color: var(--color-bg, #fff);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text, #1a1a1a);
    border: 1.5px solid var(--color-chip-border, rgba(0, 0, 0, 0.15));
  }
  .btn-secondary:hover {
    border-color: var(--color-accent, #d97757);
    color: var(--color-accent, #d97757);
  }

  /* ---- Contenido del artículo (viene de los .html por proyecto) ---- */
  .project-content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text, #23232a);
  }

  .project-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .project-content :global(h2),
  .project-content :global(h3) {
    margin: 2.2rem 0 1rem;
    line-height: 1.3;
  }

  .project-content :global(a) {
    color: var(--color-accent, #d97757);
    text-decoration: underline;
    text-decoration-color: rgba(217, 119, 87, 0.35);
    text-underline-offset: 2px;
  }
  .project-content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .project-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .project-content :global(strong) {
    font-weight: 700;
  }

  /* imagen suelta (una sola, sin hermanas) */
  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    margin: 1.5rem auto;
  }

  /* Las reglas de galería, embeds de vídeo responsive y cursor del lightbox
     viven en el componente <Lightbox />, junto al script que las aplica. */

  @media (max-width: 640px) {
    .container {
      padding: 1.5rem 1.1rem 3.5rem;
    }
    .project-hero {
      max-height: 260px;
    }
  }
</style>