---
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import { projects } from '../../data/projects';
import type { GalleryItem } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const gallery: GalleryItem[] = project.gallery ?? [{ src: project.featuredImage, type: 'image' }];
const hasGallery = gallery.length > 1;

function isVideo(src: string): boolean {
  return src.endsWith('.mp4') || src.endsWith('.webm') || src.endsWith('.mov');
}

const techList = project.technologies
  ? project.technologies.split(/\s*\/\s*|\s*,\s*/).filter(Boolean)
  : [];
---

<Layout title={`${project.title} | Ángel J. Terol`} description={project.excerpt} image={project.featuredImage}>
  <Header slot="header" />

  <div class="container">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Back to Portfolio
    </a>

    <article class="project-detail">
      <div class="project-header">
        <h1>{project.title}</h1>
      </div>
      <header class="project-hero-wrap">
        {hasGallery ? (
          <div class="hero-gallery-cover" data-hero-gallery>
            <div class="hero-gallery-track">
              {gallery.map((item, i) => (
                <div class="hero-gallery-slide" data-hero-slide={i}>
                  {item.type === 'video' || isVideo(item.src) ? (
                    <div class="video-slide">
                      <video src={item.src} muted loop playsinline controlslist="nodownload noplaybackrate" disablepictureinpicture />
                      <button class="lightbox-trigger" aria-label="Ampliar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                      </button>
                    </div>
                  ) : (
                    <img src={item.src} alt={item.alt || `${project.title} screenshot ${i + 1}`} />
                  )}
                </div>
              ))}
            </div>
            <button class="gallery-arrow prev" aria-label="Foto anterior">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="gallery-arrow next" aria-label="Foto siguiente">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
            <div class="gallery-dots">
              {gallery.map((_, i) => (
                <button class="dot" data-hero-dot={i} aria-label={`Ir a la foto ${i + 1}`} />
              ))}
            </div>
          </div>
        ) : (
          <img src={project.featuredImage} alt={project.title} class="project-hero" />
        )}
        <div class="project-meta">
          {project.year && <span class="chip chip-year">{project.year}</span>}
          {techList.map((tech) => <span class="chip">{tech}</span>)}
        </div>

        {(project.github) && (
          <div class="project-actions">
            {project.github && (
              <a href={project.github} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55v-2.17c-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/></svg>
                GitHub
              </a>
            )}
          </div>
        )}
      </header>

      <div class="project-content" set:html={project.content} />
    </article>
  </div>

  <Footer slot="footer" />
  <Lightbox />
</Layout>

<style>
  .container {
    max-width: 860px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted, #6b6b76);
    text-decoration: none;
    margin-bottom: 1.75rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .back-link:hover {
    color: var(--color-accent, #d97757);
    transform: translateX(-2px);
  }

  .project-hero-wrap {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .project-hero {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    display: block;
  }

  /* Hero gallery - coverflow style */
  .hero-gallery-cover {
    position: relative;
    height: 340px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 2em;
  }

  .hero-gallery-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-gallery-slide {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 58%;
    height: 86%;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.4s ease, filter 0.4s ease;
  }

  .hero-gallery-slide img,
  .video-slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0;
    border-radius: 0;
    max-width: none;
  }

  .video-slide {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .lightbox-trigger {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 5;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: none;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
    padding: 0;
  }

  .hero-gallery-slide[data-role='current'] .lightbox-trigger {
    opacity: 1;
  }

  .lightbox-trigger:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .hero-gallery-slide[data-role='current'] {
    transform: translate(-50%, -50%) scale(1);
    z-index: 3;
    opacity: 1;
    filter: none;
    cursor: zoom-in;
  }
  .hero-gallery-slide[data-role='prev'] {
    transform: translate(-94%, -50%) scale(0.8) rotate(-4deg);
    z-index: 2;
    opacity: 0.55;
    filter: brightness(0.75);
  }
  .hero-gallery-slide[data-role='next'] {
    transform: translate(-6%, -50%) scale(0.8) rotate(4deg);
    z-index: 2;
    opacity: 0.55;
    filter: brightness(0.75);
  }
  .hero-gallery-slide[data-role='prev']:hover,
  .hero-gallery-slide[data-role='next']:hover {
    opacity: 0.8;
    filter: brightness(0.9);
  }
  .hero-gallery-slide[data-role='hidden'] {
    transform: translate(-50%, -50%) scale(0.55);
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .hero-gallery-cover .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s ease, opacity 0.15s ease;
  }
  .hero-gallery-cover .gallery-arrow:hover {
    background: rgba(0, 0, 0, 0.65);
  }
  .hero-gallery-cover .gallery-arrow:disabled {
    opacity: 0.25;
    cursor: default;
    pointer-events: none;
  }
  .hero-gallery-cover .gallery-arrow.prev {
    left: 0.75rem;
  }
  .hero-gallery-cover .gallery-arrow.next {
    right: 0.75rem;
  }

  .hero-gallery-cover .gallery-dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 4;
  }
  .hero-gallery-cover .gallery-dots .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .hero-gallery-cover .gallery-dots .dot.is-active {
    background: var(--color-accent, #d97757);
    transform: scale(1.25);
  }

  @media (max-width: 640px) {
    .hero-gallery-cover {
      height: 220px;
    }
    .hero-gallery-slide {
      width: 72%;
    }
    .hero-gallery-slide[data-role='prev'] {
      transform: translate(-88%, -50%) scale(0.78) rotate(-4deg);
    }
    .hero-gallery-slide[data-role='next'] {
      transform: translate(-12%, -50%) scale(0.78) rotate(4deg);
    }
  }

  .project-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 0.9rem;
    letter-spacing: -0.01em;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted, #1010c0);
  }

  .chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: #1a1a1a;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--color-chip-bg, #f0efe9);
    border: 1px solid var(--color-chip-border, rgba(0, 0, 0, 0.06));
  }

  .chip-year {
    background: var(--color-accent-soft, rgba(217, 119, 87, 0.12));
    color: var(--color-accent, #d97757);
    border-color: transparent;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }

  .btn-primary {
    background: var(--color-text, #fff);
    color: var(--color-bg, #1a1a1a);
  }
  .btn-primary:hover {
    background: var(--color-accent, #d97757);
    color: var(--color-text, #FFFFFF);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text, #1a1a1a);
    border: 1.5px solid var(--color-chip-border, rgba(0, 0, 0, 0.15));
  }
  .btn-secondary:hover {
    border-color: var(--color-accent, #d97757);
    color: var(--color-accent, #d97757);
  }

  /* ---- Contenido del artículo (viene de los .html por proyecto) ---- */
  .project-content {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-text, #23232a);
    text-align: justify;
  }

  .project-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .project-content :global(h2),
  .project-content :global(h3) {
    margin: 2.2rem 0 1rem;
    line-height: 1.3;
  }

  .project-content :global(a) {
    color: var(--color-accent, #d97757);
    text-decoration: underline;
    text-decoration-color: rgba(217, 119, 87, 0.35);
    text-underline-offset: 2px;
  }
  .project-content :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.4rem;
  }
  .project-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .project-content :global(strong) {
    font-weight: 700;
  }

  /* imagen suelta (una sola, sin hermanas) */
  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
    margin: 1.5rem auto;
  }

  /* Las reglas de galería, embeds de vídeo responsive y cursor del lightbox
     viven en el componente <Lightbox />, junto al script que las aplica. */

  @media (max-width: 640px) {
    .container {
      padding: 1.5rem 1.1rem 3.5rem;
    }
    .project-hero {
      max-height: 260px;
    }
  }
</style>

<script>
  function setupHeroGallery(): void {
    const galleries = document.querySelectorAll<HTMLElement>('[data-hero-gallery]');
    galleries.forEach((gallery) => {
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-hero-slide]'));
      const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
      const prevBtn = gallery.querySelector<HTMLButtonElement>('.gallery-arrow.prev');
      const nextBtn = gallery.querySelector<HTMLButtonElement>('.gallery-arrow.next');
      if (slides.length === 0) return;

      let currentIndex = Math.floor((slides.length - 1) / 2);

      function render(): void {
        slides.forEach((slide, i) => {
          const diff = i - currentIndex;
          const role =
            diff === 0 ? 'current' : diff === -1 ? 'prev' : diff === 1 ? 'next' : 'hidden';
          slide.dataset.role = role;
        });
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === currentIndex));
        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) nextBtn.disabled = currentIndex === slides.length - 1;
      }

      function goTo(index: number): void {
        currentIndex = Math.max(0, Math.min(slides.length - 1, index));
        render();
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goTo(currentIndex - 1);
      });
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goTo(currentIndex + 1);
      });
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

      gallery.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slide = btn.closest('[data-hero-slide]') as HTMLElement | null;
          const video = slide?.querySelector('video');
          if (video) {
            video.dispatchEvent(new MouseEvent('click', { bubbles: true }));
          }
        });
      });

      gallery.querySelector('.hero-gallery-track')?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.lightbox-trigger')) return;
        const slide = target.closest('[data-hero-slide]') as HTMLElement | null;
        if (!slide) return;
        const index = slides.indexOf(slide);
        if (slide.dataset.role === 'current') {
          const img = slide.querySelector('img');
          if (img) {
            img.dispatchEvent(new MouseEvent('click', { bubbles: true }));
          }
        } else {
          goTo(index);
        }
      });

      render();
    });
  }

  document.addEventListener('astro:page-load', setupHeroGallery);
  if (document.readyState !== 'loading') {
    setupHeroGallery();
  } else {
    document.addEventListener('DOMContentLoaded', setupHeroGallery);
  }
</script>
