---
const navItems = [
	{ label: 'Portfolio', href: '/#portfolio' },
	{ label: 'About', href: '/#about' },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="brand">
			<img src="/images/2024/11/iconnobg.png" alt="Ángel J. Terol" class="brand-logo" width="80" height="80" />
			<span class="brand-title">Ángel J. Terol</span>
		</a>

		<nav class="main-nav" aria-label="Main navigation">
			<ul class="nav-list">
				{navItems.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
