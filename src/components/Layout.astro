---
export interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageWidth?: number;
    imageHeight?: number;
}

import '../styles/global.css';

const { title = 'Ángel J. Terol', description = 'Portfolio of Ángel J. Terol - Game and Software Developer', image, imageWidth = 1200, imageHeight = 630 } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://angeljterol.dev');
const ogImage = image ? new URL(image, canonicalURL).toString() : undefined;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/2024/11/iconnobg.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL.toString()} />
		{ogImage && <meta property="og:image:width" content={imageWidth.toString()} />}
		{ogImage && <meta property="og:image:height" content={imageHeight.toString()} />}
		{ogImage && <meta property="og:image" content={ogImage} />}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>
	<body>
		<div class="site-wrapper">
			<slot name="header" />
			<main id="main">
				<slot />
			</main>
			<slot name="footer" />
		</div>
	</body>
</html>
