---
export interface Props {
	title?: string;
	description?: string;
}

import '../styles/global.css';

const { title = 'Ángel J. Terol', description = 'Portfolio of Ángel J. Terol - Game and Software Developer' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/images/2024/11/iconnobg.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-wrapper">
			<slot name="header" />
			<main id="main">
				<slot />
			</main>
			<slot name="footer" />
		</div>
	</body>
</html>
