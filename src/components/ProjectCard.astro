---
import type { Project } from '../data/projects';

export interface Props {
	project: Project;
	class?: string;
	style?: string;
}

const { project, class: className, style } = Astro.props;

const techList = project.technologies
	? project.technologies.split(/\s*\/\s*|\s*,\s*/).filter(Boolean)
	: [];
---

<article class:list={['project-card', className]} style={style}>
	<a href={`/project/${project.slug}/`} class="card-link">
		<img src={project.featuredImage} alt={project.title} loading="lazy" class="card-bg" />
		<div class="card-overlay">
			<h2 class="card-title">{project.title}</h2>
			<p class="card-excerpt">{project.excerpt}</p>
			{techList.length > 0 && (
				<div class="card-tags">
					{techList.map((tech) => (
						<span class="card-tag">{tech.trim()}</span>
					))}
				</div>
			)}
		</div>
	</a>
</article>
